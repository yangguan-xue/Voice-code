# ============================================================
# Copy this file to .env and fill in your local settings.
#   cp .env.example .env
# ============================================================

# Default OpenAI-compatible chat model.
LLM_API_KEY=replace-with-your-api-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-v4-pro

# Select a profile from models.toml.
# LLM_PROFILE=deepseek

# Local OpenAI-compatible server.
# LOCAL_LLM_API_KEY=not-needed
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL_NAME=your-local-model

# Local Ollama server.
# OLLAMA_API_KEY=not-needed
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_NAME=qwen2.5-coder

# Voice mode.
# STEPFUN_API_KEY=replace-with-your-stepfun-key
# VOICE_STT_URL=http://localhost:8765
# VOICE_TTS_URL=http://localhost:8775

# Persistent memory RAG (optional).
# Run first: uv sync --extra milvus
# MEMORY_EMBEDDING_BASE_URL=https://your-provider.example/compatible-mode/v1
# MEMORY_EMBEDDING_API_KEY=set-by-secret-manager
# MEMORY_EMBEDDING_MODEL=text-embedding-v4
# MEMORY_EMBEDDING_DIMENSION=1024
# MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=voice_code_user_memory_v1
# REASONING_MEMORY_ENABLED=true

# Long-term memory extraction defaults to off. Use shadow/review first;
# automatic mode should only be enabled after passing a gate report.
# REASONING_MEMORY_EXTRACTION_MODE=off
# MEMORY_EXTRACTION_BASE_URL=https://your-provider.example/compatible-mode/v1
# MEMORY_EXTRACTION_API_KEY=set-by-secret-manager
# MEMORY_EXTRACTION_MODEL=your-chat-model
# MEMORY_EXTRACTION_TIMEOUT_SECONDS=10
# MEMORY_EXTRACTION_MIN_CONFIDENCE=0.9
# MEMORY_EXTRACTION_MAX_CANDIDATES_PER_TURN=2
# MEMORY_EXTRACTION_GATE_REPORT=/absolute/path/to/passing-gate.json
