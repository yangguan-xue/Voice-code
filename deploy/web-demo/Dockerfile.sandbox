FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n%s\n%s\n' \
        'deb http://mirrors.tencent.com/debian trixie main' \
        'deb http://mirrors.tencent.com/debian-security trixie-security main' \
        'deb http://mirrors.tencent.com/debian trixie-updates main' \
        > /etc/apt/sources.list \
    && apt-get -o Acquire::ForceIPv4=true update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        bash \
        bubblewrap \
        git \
        grep \
        procps \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir pytest

WORKDIR /workspace
